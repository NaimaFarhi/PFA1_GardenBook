                <mxCell id="13" value="Pré-condition" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;spacingLeft=10;labelBorderColor=none;textShadow=0;fontColor=light-dark(#000000,#FFFFFF);" parent="12" vertex="1">
                    <mxGeometry width="120" height="60" as="geometry">
